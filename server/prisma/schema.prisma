// 1. Connection & Setup
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  // output লাইনটি মুছে ফেলা হয়েছে যাতে এটি node_modules-এ তৈরি হয়
}

// 2. Enums
enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum FeeStatus {
  PAID
  PENDING
  OVERDUE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// 3. Models
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())

  studentProfile Student?
  teacherProfile Teacher?
}

model Student {
  id            Int      @id @default(autoincrement())
  rollNo        String   @unique
  phone         String?
  address       String?
  guardianName  String?
  guardianPhone String?

  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id])
  
  classId   Int
  class     Class    @relation(fields: [classId], references: [id])

  fees      Fee[]
  feedbacks Feedback[]
}

model Teacher {
  id        Int      @id @default(autoincrement())
  subject   String
  
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id])

  classes   Class[]
}

model Class {
  id            Int            @id @default(autoincrement())
  name          String
  section       String
  
  students      Student[]
  teachers      Teacher[]
  schedules     Schedule[]
  specialClasses SpecialClass[]
}

model Fee {
  id          Int       @id @default(autoincrement())
  amount      Float
  title       String
  dueDate     DateTime
  status      FeeStatus @default(PENDING)
  paidAt      DateTime?

  studentId   Int
  student     Student   @relation(fields: [studentId], references: [id])
}

model Schedule {
  id        Int       @id @default(autoincrement())
  day       DayOfWeek
  startTime String
  endTime   String
  subject   String
  
  classId   Int
  class     Class     @relation(fields: [classId], references: [id])
}

model SpecialClass {
  id        Int      @id @default(autoincrement())
  topic     String
  date      DateTime
  startTime String
  endTime   String
  
  classId   Int
  class     Class    @relation(fields: [classId], references: [id])
}

model Feedback {
  id        Int      @id @default(autoincrement())
  message   String
  isAnonymous Boolean @default(false)
  createdAt DateTime @default(now())

  studentId Int
  student   Student  @relation(fields: [studentId], references: [id])
}